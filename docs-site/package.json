{
  "name": "@roastcodes/ttdash-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/run-astro.mjs dev",
    "check": "node scripts/run-astro.mjs check && markdownlint-cli2 \"src/content/docs/**/*.{md,mdx}\"",
    "build": "node scripts/run-astro.mjs build",
    "preview": "node scripts/run-astro.mjs preview",
    "verify": "npm run check && npm run build"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.4",
    "@astrojs/starlight": "0.42.6",
    "astro": "7.4.2",
    "starlight-links-validator": "0.27.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "markdownlint-cli2": "0.24.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "markdownlint-cli2": {
      "smol-toml": "^1.8.0"
    }
  }
}
